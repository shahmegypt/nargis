# Copy to .env.local. Server values are read by the Vite development server only.
# Do not prefix Grok/private VAPID values with VITE_.
GROK_API_KEY=
GROK_MODEL=grok-4.7

# Browser Supabase configuration. Use the publishable key, never service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_VAPID_PUBLIC_KEY=

# Optional server-side aliases; Vite falls back to the VITE_ pair above in local dev.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
